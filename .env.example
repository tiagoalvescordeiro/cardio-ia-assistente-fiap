# =============================================================================
# CardioIA Assistente — variáveis de ambiente (NUNCA commitar o arquivo .env)
# Copie este arquivo para .env e preencha apenas o que for usar.
# Sem credenciais IBM o backend sobe em modo fallback (regra local).
# =============================================================================

# --- Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*

# --- IBM Watson Assistant v2 / watsonx Assistant (opcional) ---
# Se WATSON_API_KEY ou WATSON_ASSISTANT_ID estiverem vazios, usa fallback local.
# Session/message usam WATSON_ENVIRONMENT_ID no path (draft ou live). Sem ele, usa o assistant_id.
# WATSON_SKILL_ID é opcional — o script scripts/publish_watson_skill.py descobre o skill de diálogo.
WATSON_API_KEY=
WATSON_URL=https://api.us-south.assistant.watson.cloud.ibm.com
# Alias aceito pelo backend (mesmo valor de WATSON_URL). Não commitar chaves.
# WATSON_SERVICE_URL=
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=
WATSON_SKILL_ID=
WATSON_VERSION=2024-08-25

# --- LLM / extração clínica (opcional, OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Persistência relacional (padrão: SQLite local) ---
# Exemplos:
#   sqlite:///C:/Users/Usuario/Projects/cardio-ia-assistente/data/cardioia.db
#   postgresql://user:pass@localhost:5432/cardioia
DATABASE_URL=sqlite:///./data/cardioia.db

# --- Persistência NoSQL (padrão: arquivo JSON; Mongo opcional) ---
NOSQL_JSON_PATH=./data/rpa_audit_store.json
MONGO_URI=
MONGO_DB=cardioia
MONGO_COLLECTION=rpa_audit_logs

# --- RPA ---
RPA_POLL_INTERVAL_SECONDS=15
RPA_SQLITE_PATH=./data/cardioia.db
